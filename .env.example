# EvalForge configuration (prefix EF_)
EF_JUDGE=deterministic          # deterministic | llm
EF_SIMILARITY_THRESHOLD=0.30    # claim-support threshold for faithfulness
EF_OTEL_ENABLED=false           # emit OpenTelemetry spans to the console

# When EF_JUDGE=llm, the judge uses a provider cascade (first one that works wins):
EF_LLM_PROVIDERS=anthropic,openai,gemini,deepseek,ollama
# Set keys only for the providers you use. Ollama is local and needs no key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_HOST=http://localhost:11434
