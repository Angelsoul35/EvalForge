# EvalForge configuration (prefix EF_)
EF_JUDGE=deterministic          # deterministic | anthropic
EF_SIMILARITY_THRESHOLD=0.30    # claim-support threshold for faithfulness
EF_OTEL_ENABLED=false           # emit OpenTelemetry spans to the console
# Only needed when EF_JUDGE=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# EF_ANTHROPIC_MODEL=claude-sonnet-4-5
